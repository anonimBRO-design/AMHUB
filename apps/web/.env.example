NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anti-abuse: REQUIRED to salt IP-hash fingerprints (do NOT reuse the service key).
# If unset, a static default salt is used (hashed values will not be unique per deploy).
IP_HASH_SALT=

# Payment webhook: REQUIRED for /api/webhooks/payments. The webhook fail-closes
# (rejects all callbacks) when this secret is not configured.
PAYMENT_WEBHOOK_SECRET=

# Canonical site origin — single source of truth for OAuth/email redirect URLs.
# Production: https://amhub.anonimbro.my.id (set in Vercel Production env only).
# Leave unset for local dev / preview deployments (falls back to current origin).
NEXT_PUBLIC_APP_URL=

# PostHog Configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
